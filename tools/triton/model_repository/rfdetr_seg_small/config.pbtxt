name: "rfdetr_seg_small"
backend: "onnxruntime"
# Static batch already in the shapes ([1,3,384,384]); no Triton batching.
max_batch_size: 0
input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [ 1, 3, 384, 384 ]
  }
]
output [
  {
    name: "dets"
    data_type: TYPE_FP32
    dims: [ 1, 100, 4 ]
  },
  {
    name: "labels"
    data_type: TYPE_FP32
    dims: [ 1, 100, 91 ]
  },
  {
    name: "masks"
    data_type: TYPE_FP32
    dims: [ 1, 100, 96, 96 ]
  }
]
instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]
