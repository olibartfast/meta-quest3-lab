name: "rfdetr_medium"
backend: "onnxruntime"
# Static batch already in the shapes ([1,3,576,576]); no Triton batching.
max_batch_size: 0
input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [ 1, 3, 576, 576 ]
  }
]
output [
  {
    name: "dets"
    data_type: TYPE_FP32
    dims: [ 1, 300, 4 ]
  },
  {
    name: "labels"
    data_type: TYPE_FP32
    dims: [ 1, 300, 91 ]
  }
]
instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]
